# =============================================================================
# Freak Hub — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores. Nunca subas el `.env` real.
# Las claves de Clerk para la web se generan aparte con `clerk env pull`.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=freakhub
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=freakhub
POSTGRES_PORT=5432
# Cadena que consume la API en Go. En Docker el host es el nombre del servicio.
DATABASE_URL=postgres://freakhub:change-me-in-production@localhost:5432/freakhub?sslmode=disable

# --- MinIO (almacenamiento S3-compatible) ------------------------------------
MINIO_ROOT_USER=freakhub
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=freakhub-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=freakhub
S3_SECRET_ACCESS_KEY=change-me-in-production
S3_USE_PATH_STYLE=true

# --- API en Go ---------------------------------------------------------------
API_PORT=8080
API_ENV=development
# Orígenes permitidos por CORS, separados por comas.
API_ALLOWED_ORIGINS=http://localhost:3000
# Nivel de log: debug | info | warn | error
API_LOG_LEVEL=debug

# --- Clerk (backend) ---------------------------------------------------------
# La API en Go verifica los JWT contra el JWKS de Clerk y usa la Backend API
# para crear invitaciones. Saca ambos valores del panel de Clerk.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Secreto de firma del endpoint de webhooks (Clerk > Webhooks > Signing Secret).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
# Emisor esperado en el JWT. Lo ves en Clerk > API Keys > Frontend API URL.
CLERK_JWT_ISSUER=https://xxx.clerk.accounts.dev

# --- Web (Next.js) -----------------------------------------------------------
# URL pública de la API que consume el navegador y el servidor de Next.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- APIs de catálogo externas ----------------------------------------------
# AniList (anime y manga) — GraphQL público, no requiere clave.
ANILIST_API_URL=https://graphql.anilist.co
# TMDB (películas) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# IGDB (videojuegos) — credenciales de Twitch: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# BoardGameGeek (juegos de mesa) — XML API2 pública, no requiere clave.
BGG_API_URL=https://boardgamegeek.com/xmlapi2
# Scryfall (TCG) — API pública, no requiere clave.
SCRYFALL_API_URL=https://api.scryfall.com
