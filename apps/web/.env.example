# =============================================================================
# apps/web — variables de la aplicación Next.js
#
# Las claves de Clerk se generan solas:  clerk env pull --file .env.local
# Este archivo documenta el resto de valores que la web necesita.
# =============================================================================

# --- Clerk -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Rutas de auth. Deben coincidir con `paths` en la configuración del instance.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inicio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/inicio

# Secreto de firma del webhook que sincroniza usuarios con la API.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- API en Go ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E2E con sesión (Playwright + @clerk/testing) -----------------------------
# Playwright carga este fichero (.env.local) con el directorio de trabajo en
# apps/web, así que declararlas solo en el .env.example de la raíz no basta:
# la misma trampa que ANILIST_API_URL, más abajo.
#
# Usuario dedicado de la instancia de desarrollo de Clerk. Sin él, los
# recorridos con sesión se omiten explícitamente; el perímetro sigue corriendo.
# Usa una dirección con `+clerk_test`: Clerk no la entrega nunca y acepta el
# código 424242, que es la única vía que completa la sesión en esta instancia
# (docs/testing.md explica por qué la contraseña se queda a medias).
E2E_CLERK_USER_IDENTIFIER=
# Solo si el identificador NO es una dirección `+clerk_test`. En esta instancia
# un inicio de sesión por contraseña se queda en `needs_client_trust`.
E2E_CLERK_USER_PASSWORD=
# Correo al que se invita en el recorrido de invitaciones. Por defecto se genera
# uno con el sufijo `+clerk_test`. Rellénalo solo si quieres verlo en un buzón.
E2E_INVITEE_EMAIL=

# --- Catálogos externos ------------------------------------------------------
# AniList (anime) — GraphQL público, sin clave. Lo lee el cliente temporal de
# `features/library/lib/anilist.ts` mientras la API en Go no tenga su propia
# integración (docs/catalogs.md). Sin el prefijo NEXT_PUBLIC_ a propósito: la
# llamada sale del servidor. Next carga este fichero desde apps/web, así que
# declararla solo en el .env.example de la raíz no basta.
ANILIST_API_URL=https://graphql.anilist.co
