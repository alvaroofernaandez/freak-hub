# =============================================================================
# apps/web — variables de la aplicación Next.js
#
# Las claves de Clerk se generan solas:  clerk env pull --file .env.local
# Este archivo documenta el resto de valores que la web necesita.
# =============================================================================

# --- Clerk -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Rutas de auth. Deben coincidir con `paths` en la configuración del instance.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/inicio
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/inicio

# Secreto de firma del webhook que sincroniza usuarios con la API.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# --- API en Go ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
