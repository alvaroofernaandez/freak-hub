{
  "name": "@freak-hub/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI contract between the web and the Go API, and the TypeScript types generated from it",
  "exports": {
    ".": "./generated/api.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml --output generated/api.ts",
    "validate": "redocly lint openapi.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^2.5.0",
    "openapi-typescript": "^7.9.1"
  }
}
